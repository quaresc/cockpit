+from src.quotas import QuotaExceeded, enforce, remaining
+
+
+def test_remaining_never_goes_below_zero():
+    assert remaining("free", 150) == 0
+
+
+def test_enforce_refuses_past_the_limit():
+    try:
+        enforce("free", 100)
+    except QuotaExceeded:
+        return
+    raise AssertionError("expected QuotaExceeded")
