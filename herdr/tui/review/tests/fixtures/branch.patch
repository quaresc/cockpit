 """Daily quotas for the acme API: how many calls a plan may make in a day."""
 
 PLANS = {"free": 100, "team": 5_000, "enterprise": 50_000}
+# Calls past the limit still allowed, so a burst at midnight does not fail.
+GRACE = 10
+
+
+class QuotaExceeded(Exception):
+    """A plan made more calls today than it may."""
 
 
 def daily_limit(plan: str) -> int:
@@ -9,4 +15,10 @@ def daily_limit(plan: str) -> int:
 
 
 def remaining(plan: str, used: int) -> int:
-    return daily_limit(plan) - used
+    return max(0, daily_limit(plan) - used)
+
+
+def enforce(plan: str, used: int) -> None:
+    """Refuses the call once the plan's daily limit is reached."""
+    if used >= daily_limit(plan) + GRACE:
+        raise QuotaExceeded(plan)
